+      { label: "Tier", get: function (r) { return r.tier; } },
+      { label: "Return period (years)", num: 1, get: function (r) { return r.return_period_years; } },
+      { label: "Annual exceedance probability", num: 1, get: function (r) { return pct(r.annual_exceedance_probability); } },
+      { label: "Portfolio loss (KES)", num: 1, get: function (r) { return kes(r.portfolio_loss_kes); } },
+      { label: "Loss, % of portfolio", num: 1, get: function (r) { return pct(r.loss_pct_portfolio); } }
+    ], d.ep_points.filter(function (r) { return r.scenario_id === sc; })));
+    $("t-class").replaceChildren(table("Loss by housing class - " + tier + " tier, scenario " + sc, [
+      { label: "Housing class", get: function (r) { return r.housing_class; } },
+      { label: "Buildings", num: 1, get: function (r) { return nf0.format(r.buildings); } },
+      { label: "Affected", num: 1, get: function (r) { return nf0.format(r.affected_buildings); } },
+      { label: "Loss (KES)", num: 1, get: function (r) { return kes(r.loss_kes); } },
+      { label: "Loss ratio", num: 1, get: function (r) { return pct(r.loss_ratio); } },
+      { label: "Share of tier loss", num: 1, get: function (r) { return pct(r.share_of_tier_loss); } }
+    ], d.class_summary.filter(function (r) { return r.scenario_id === sc && r.tier === tier; })));
+  }
+
+  function send(path) {
+    if (!state.file) { banner("warn", "Choose a file first."); return; }
+    if (!$("key").value) { banner("warn", "Enter the API key."); return; }
+    var fd = new FormData();
+    fd.append("file", state.file);
+    if ($("synthetic").value) fd.append("synthetic", $("synthetic").value);
+    if ($("accept").checked) fd.append("accept_uncertain", "true");
+    $("run").disabled = $("adapt").disabled = true;
+    $("results").hidden = true; $("model").hidden = true;
+    banner("warn", "Working", ["Reading the file" + (path === "/run" ? " and running the loss model." : ".")]);
+    fetch(path, { method: "POST", headers: { "X-API-Key": $("key").value }, body: fd })
+      .then(function (res) { return res.json().then(function (j) { return { code: res.status, body: j }; }, function () { return { code: res.status, body: {} }; }); })
+      .then(function (r) { handle(path, r.code, r.body); })
+      .catch(function () { banner("bad", "Could not reach the server."); })
+      .then(function () { $("run").disabled = $("adapt").disabled = false; });
+  }
+
+  function handle(path, code, b) {
+    state.data = b;
+    if (code === 401) return banner("bad", "The API key was not accepted.");
+    if (code === 413) return banner("bad", "The file is larger than 10 MB.");
+    if (code === 415) return banner("bad", "That file type is not supported.", [b.detail || ""]);
+    if (code === 429 || code >= 500) return banner("bad", "The server could not process the request.", [b.detail || ""]);
+    if (b.detail && !b.report && !b.adaptation_report) return banner("bad", "The file could not be used.", [typeof b.detail === "string" ? b.detail : "Check the form fields."]);
+    var report = b.report || b.adaptation_report || {};
+    var status = b.status || b.adapter_status || "";
+    $("results").hidden = false;
+    renderAdaptation(report, status);
+    if (path === "/adapt") {
+      $("model").hidden = true;
+      if (status === "refused") banner("bad", "The adapter refused this file.", ["The reasons are listed below; nothing was guessed."]);
+      else if (status === "needs_confirmation") banner("warn", "The adapter needs confirmation.", ["Review the proposals below, then tick the accept box or fix the file."]);
+      else banner("ok", "File adapted.", ["The adapted file meets the model schema. Use Run loss model to calculate losses."]);
+      return;
+    }
+    if (b.run_status === "completed") { banner("ok", "Loss model completed.", ["Run " + b.run_id + " - " + nf0.format(b.row_count) + " buildings, total insured value KES " + kes(Number(b.total_insured_value || b.total_tiv_kes)) + "."]); renderModel(b); return; }
+    if (b.run_status === "failed") return banner("bad", "The loss engine stopped on a failed rule.", ["Rule stage: " + b.failed_at, b.failure || ""]);
+    if (status === "refused") return banner("bad", "The adapter refused this file, so the model was not run.");
+    banner("warn", "The model was not run.", [b.message || "The adapter needs confirmation."]);
+  }
+
+  function setFile(f) { state.file = f; $("fname").textContent = f ? f.name + " (" + Math.ceil(f.size / 1024) + " KB)" : "Choose a file or drop it here"; }
+  $("file").addEventListener("change", function (e) { setFile(e.target.files[0] || null); });
+  var drop = $("drop");
+  ["dragenter", "dragover"].forEach(function (t) { drop.addEventListener(t, function (e) { e.preventDefault(); drop.classList.add("over"); }); });
+  ["dragleave", "drop"].forEach(function (t) { drop.addEventListener(t, function (e) { e.preventDefault(); drop.classList.remove("over"); }); });
+  drop.addEventListener("drop", function (e) { if (e.dataTransfer.files[0]) setFile(e.dataTransfer.files[0]); });
+  $("run").addEventListener("click", function () { send("/run"); });
+  $("adapt").addEventListener("click", function () { send("/adapt"); });
+  $("scenario").addEventListener("change", drawTables);
+  $("tier").addEventListener("change", drawTables);
+})();
+</script>
+</body>
+</html>
