# Placeholders only. Copy to .env (ignored by Git) and fill in locally.
# Never put these values in frontend/ files: the browser must not see them.

# Django (backend/)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true

# Checkpoint 8 live extraction (optional). Without both, only the bundled
# example can be processed, by replay.
GEMINI_MODEL=
GEMINI_API_KEY=

# Upload service (api/main.py). Any long random string; Django forwards
# uploads to the service with it.
ADAPTER_API_KEY=
INGEST_API_URL=http://127.0.0.1:8001

# Email one-time codes (Zoho SMTP). Empty EMAIL_HOST prints codes to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# SMS one-time codes (Africa's Talking)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
